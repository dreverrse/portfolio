# ============================================================
# Salin ke .env.local lalu isi nilainya.
# Jangan pernah commit .env.local atau menaruh secret di repo.
# ============================================================

# --- Admin panel (wajib untuk /admin) ---
# ADMIN_PASSWORD: password login admin (minimal 12 karakter, sebaiknya acak)
ADMIN_PASSWORD=
# ADMIN_SECRET: secret untuk tanda tangan token session. PISAHKAN dari password.
ADMIN_SECRET=

# --- Supabase (database posts, komentar, reaksi, cache terjemahan) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (rate limiting; tanpa ini fallback ke memori per-instance) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OpenRouter (waifu chat AI + AI assistant + terjemahan blog) ---
OPENROUTER_API_KEY=
# Daftar model dipisah koma, urut prioritas
OPENROUTER_MODELS=google/gemini-2.5-flash,deepseek/deepseek-chat

# --- OpenCode Zen (admin chat, model big-pickle) ---
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=big-pickle

# --- Last.fm (widget musik) ---
LASTFM_API_KEY=
LASTFM_USERNAME=

# --- GitHub stats (opsional; tanpa ini memakai rate limit publik 60/jam) ---
GITHUB_TOKEN=

# --- Situs publik ---
NEXT_PUBLIC_SITE_URL=https://dreverrse.my.id
